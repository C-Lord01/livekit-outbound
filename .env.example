# Copy to .env and fill in real values. .env is gitignored; never commit it.

# --- LiveKit Cloud project (Settings -> Keys in the LiveKit Cloud dashboard) ---
LIVEKIT_URL=wss://your-project-xxxxxxxx.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=your-livekit-api-secret

# --- Twilio Elastic SIP Trunk (Twilio Console -> Elastic SIP Trunking -> Trunks) ---
# The trunk SID is informational only; LiveKit talks to the termination URI below.
TWILIO_TRUNK_SID=TKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Termination SIP URI from the trunk's "Termination" tab, host only, no "sip:" prefix.
TWILIO_SIP_TERMINATION_URI=your-trunk-name.pstn.twilio.com
# Username/password from the Credential List attached to the trunk's termination settings.
TWILIO_SIP_USERNAME=your-credential-list-username
TWILIO_SIP_PASSWORD=your-credential-list-password
# A Twilio phone number on this trunk, E.164. Used as the outbound caller ID.
TWILIO_PHONE_NUMBER=+15551234567

# --- LiveKit SIP trunk created by scripts/create_trunk.py ---
# Name used for idempotent lookup; change it only if you want a second trunk.
LIVEKIT_SIP_TRUNK_NAME=twilio-outbound
# Optional. If unset, scripts/dial.py resolves the trunk by LIVEKIT_SIP_TRUNK_NAME.
SIP_OUTBOUND_TRUNK_ID=

# --- Agent ---
# Explicit-dispatch name registered by agent.py and targeted by scripts/dial.py.
AGENT_NAME=outbound-caller

# --- Speech and language providers used by agent.py ---
DEEPGRAM_API_KEY=your-deepgram-api-key
OPENAI_API_KEY=sk-your-openai-api-key
CARTESIA_API_KEY=your-cartesia-api-key

# --- Policy gate ---
# SQLAlchemy URL for the gate database (contacts, call history, suppression
# flags, audit log). Defaults to a SQLite file at ./data/gate.db when unset.
# Seed it with scripts/seed_gate.py.
# GATE_DATABASE_URL=sqlite:///data/gate.db
